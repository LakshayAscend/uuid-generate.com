            </svg>
            <svg id="theme-icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 13a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" fill="currentColor"/>
            </svg>
          </button>

          <button id="nav-copy-btn" class="btn-ghost hidden md:flex" onclick="window.quickCopy && window.quickCopy()" title="Quick copy UUID (Ctrl+C)">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <rect x="4" y="4" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
              <path d="M2 10V2h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            Copy UUID
          </button>

          <!-- Mobile menu button (hidden on desktop) -->
          <button id="mobile-menu-btn" class="btn-ghost md:hidden" aria-label="Open menu" aria-expanded="false">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Menu (sticky positioned) -->
    <div id="mobile-menu" class="mobile-menu hidden md:hidden sticky top-12 z-40" style="background:var(--color-canvas-elevated);border-bottom:1px solid var(--color-hairline);">
      <nav class="container flex flex-col gap-1 py-3" aria-label="Mobile navigation">
        <a href="/" class="nav-link block">Generate</a>
        <a href="/validate" class="nav-link block">Validate</a>
        <a href="/bulk" class="nav-link block">Bulk Export</a>
        <a href="/decode" class="nav-link block">Decode</a>
        <a href="/about" class="nav-link block">About</a>
      </nav>
    </div>

    <!-- Overlay for mobile menu -->
    <div id="mobile-menu-overlay" class="hidden fixed inset-0 bg-black/20 z-30 md:hidden" style="backdrop-filter: blur(2px);"></div>

    <!-- Page Content (add margin when menu is open) -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:var(--spacing-xl);">
          <div>
            <div style="font-weight:600;color:var(--color-ink);margin-bottom:var(--spacing-sm);">UUID Generator</div>
            <p style="color:var(--color-mute);font-size:13px;line-height:1.5;margin:0;">
              Fast, free, developer-friendly UUID generation. No ads. No tracking.
            </p>
          </div>
          <div>
            <div class="mono-eyebrow" style="color:var(--color-mute);margin-bottom:var(--spacing-sm);">Tools</div>
            <div style="display:flex;flex-direction:column;gap:6px;">
              <a href="/" class="nav-link" style="padding:2px 6px;">UUID v4 Generator</a>
              <a href="/validate" class="nav-link" style="padding:2px 6px;">UUID Validator</a>
              <a href="/bulk" class="nav-link" style="padding:2px 6px;">Bulk Generator</a>
              <a href="/decode" class="nav-link" style="padding:2px 6px;">UUID Decoder</a>
            </div>
          </div>
          <div>
            <div class="mono-eyebrow" style="color:var(--color-mute);margin-bottom:var(--spacing-sm);">Versions</div>
            <div style="display:flex;flex-direction:column;gap:6px;">
              <a href="/?v=1" class="nav-link" style="padding:2px 6px;">UUID v1 (time-based)</a>
              <a href="/?v=4" class="nav-link" style="padding:2px 6px;">UUID v4 (random)</a>
              <a href="/?v=7" class="nav-link" style="padding:2px 6px;">UUID v7 (Unix epoch)</a>
            </div>
          </div>
          <div>
            <div class="mono-eyebrow" style="color:var(--color-mute);margin-bottom:var(--spacing-sm);">Resources</div>
            <div style="display:flex;flex-direction:column;gap:6px;">
              <a href="/about" class="nav-link" style="padding:2px 6px;">About UUIDs</a>
              <a href="/about#rfc4122" class="nav-link" style="padding:2px 6px;">RFC 4122 / 9562</a>
              <a href="/about#faq" class="nav-link" style="padding:2px 6px;">FAQ</a>
            </div>
          </div>
          <div>
            <div class="mono-eyebrow" style="color:var(--color-mute);margin-bottom:var(--spacing-sm);">Company & Legal</div>
            <div style="display:flex;flex-direction:column;gap:6px;">
              <a href="/about-us" class="nav-link" style="padding:2px 6px;">About Us</a>
              <a href="/contact-us" class="nav-link" style="padding:2px 6px;">Contact Us</a>
              <a href="/privacy-policy" class="nav-link" style="padding:2px 6px;">Privacy Policy</a>
              <a href="/terms-and-conditions" class="nav-link" style="padding:2px 6px;">Terms &amp; Conditions</a>
            </div>
          </div>
        </div>
        <div style="border-top:1px solid var(--color-hairline);margin-top:var(--spacing-xl);padding-top:var(--spacing-md);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
          <span style="color:var(--color-mute);font-size:12px;">© 2025 uuid-generate.com — Free to use. No ads.</span>
          <div style="display:flex;align-items:center;gap:12px;">
            <a href="/privacy-policy" class="nav-link" style="padding:0;font-size:12px;color:var(--color-faint);">Privacy</a>
            <span style="color:var(--color-hairline);">•</span>
            <a href="/terms-and-conditions" class="nav-link" style="padding:0;font-size:12px;color:var(--color-faint);">Terms</a>
            <span style="color:var(--color-hairline);">•</span>
            <span style="color:var(--color-faint);font-size:12px;">RFC 4122 compliant</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Toast container -->
    <div id="toast-container" aria-live="polite" aria-label="Notifications"></div>

    <!-- Global scripts -->
    <script>
      // Theme toggle - dark mode by default
      (function() {
        const themeToggle = document.getElementById('theme-toggle');
        const themeIconSun = document.getElementById('theme-icon-sun');
        const themeIconMoon = document.getElementById('theme-icon-moon');

        // Set dark as default if no theme is stored
        let currentTheme = localStorage.getItem('theme');
        if (!currentTheme) {
          currentTheme = 'dark';
          localStorage.setItem('theme', 'dark');
        }

        // Apply theme
        function applyTheme(theme) {
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            if (themeIconSun) themeIconSun.classList.remove('hidden');
            if (themeIconMoon) themeIconMoon.classList.add('hidden');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
            if (themeIconSun) themeIconSun.classList.add('hidden');
            if (themeIconMoon) themeIconMoon.classList.remove('hidden');
          }
        }

        // Initial theme application
        applyTheme(currentTheme);

        // Toggle handler
        if (themeToggle) {
          themeToggle.addEventListener('click', () => {
            if (currentTheme === 'dark') {
              currentTheme = 'light';
            } else {
              currentTheme = 'dark';
            }
            localStorage.setItem('theme', currentTheme);
            applyTheme(currentTheme);
          });
        }
      })();

      // Mobile menu with overlay
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');

      function toggleMobileMenu() {
        const isHidden = mobileMenu?.classList.contains('hidden');
        mobileMenu?.classList.toggle('hidden');
        mobileMenuOverlay?.classList.toggle('hidden');
        mobileMenuBtn?.setAttribute('aria-expanded', String(isHidden));

        // Prevent body scroll when menu is open
        if (isHidden) {
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
        }
      }

      mobileMenuBtn?.addEventListener('click', toggleMobileMenu);
      mobileMenuOverlay?.addEventListener('click', toggleMobileMenu);

      // Close mobile menu when clicking a link
      mobileMenu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu?.classList.add('hidden');
          mobileMenuOverlay?.classList.add('hidden');
          mobileMenuBtn?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        });
      });

      // Highlight active nav link
      const path = window.location.pathname;
      document.querySelectorAll('.nav-link[href]').forEach(link => {
        const href = link.getAttribute('href') ?? '';
        if (href === path || (path === '/' && href === '/') || (path !== '/' && href !== '/' && path.startsWith(href))) {
          link.classList.add('active');
        }
      });

      // Global toast system
      function showToast(message: string, icon = '✓') {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.innerHTML = `<span>${icon}</span><span>${message}</span>`;
        container.appendChild(toast);
        setTimeout(() => {
          toast.classList.add('toast-exit');
          setTimeout(() => toast.remove(), 220);
        }, 2200);
      }
      window.showToast = showToast;

      // Global copy UUID from nav button (uses global lastUUID set by page)
      function quickCopy() {
        const uuid = window.lastUUID;
        if (uuid) {
          navigator.clipboard.writeText(uuid).then(() => {
            window.showToast('UUID copied!');
          }).catch(() => {});
        }
      }
      window.quickCopy = quickCopy;

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        // Ctrl/Cmd + G = Generate new UUID
        if ((e.ctrlKey || e.metaKey) && e.key === 'g') {
          e.preventDefault();
          const generateBtn = document.getElementById('generate-btn');
          generateBtn?.click();
        }
        // Ctrl/Cmd + Shift + C = Copy UUID
        if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === 'C') {
          e.preventDefault();
          const copyBtn = document.getElementById('copy-uuid-btn');
          copyBtn?.click();
        }
      });
    </script>
  </body>
</html>

