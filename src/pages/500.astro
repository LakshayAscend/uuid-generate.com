---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="500 — Server Error"
  description="An unexpected error occurred. All UUID generator operations run client-side in your browser."
  noIndex={true}
>
  <section class="container flex flex-col items-center justify-center text-center section-band" style="min-height: calc(80vh - 48px); max-width: 680px; margin: 0 auto; padding: var(--spacing-4xl) var(--spacing-md);">
    
    <!-- Eyebrow Badge -->
    <div style="display:inline-flex;align-items:center;gap:6px;background:var(--color-canvas-elevated);border:1px solid var(--color-hairline);padding:4px 12px;border-radius:var(--radius-pill);margin-bottom:var(--spacing-lg);">
      <span style="width:8px;height:8px;border-radius:50%;background:var(--color-error);display:inline-block;"></span>
      <span class="mono-eyebrow" style="color:var(--color-mute);font-size:11px;">Error 500</span>
    </div>

    <!-- Main Heading -->
    <h1 class="display-xl" style="font-size:clamp(36px, 7vw, 64px);margin:0 0 var(--spacing-md);letter-spacing:-2px;">
      Something Went Wrong
    </h1>

    <p class="body-lg" style="color:var(--color-body);max-width:540px;margin:0 auto var(--spacing-2xl);">
      An unexpected internal issue occurred. Because UUID Generator operates 100% in your local browser memory, reloading the page usually resolves any temporary state glitches.
    </p>

    <!-- Info Box -->
    <div class="feature-card" style="width:100%;margin-bottom:var(--spacing-2xl);padding:var(--spacing-lg);text-align:left;background:var(--color-canvas-elevated);">
      <div style="display:flex;align-items:flex-start;gap:var(--spacing-sm);">
        <div style="font-size:20px;line-height:1;">💡</div>
        <div>
          <h2 class="label-sm" style="color:var(--color-ink);margin:0 0 4px;">Troubleshooting Tips</h2>
          <ul style="color:var(--color-body);font-size:13px;line-height:1.6;margin:0;padding-left:18px;">
            <li>Click <strong>Reload Page</strong> to refresh client-side state.</li>
            <li>Ensure your browser has JavaScript and the standard Web Crypto API enabled.</li>
            <li>If the issue persists, let us know via our Contact form.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div style="display:flex;gap:var(--spacing-sm);justify-content:center;flex-wrap:wrap;width:100%;">
      <button onclick="window.location.reload()" class="btn-primary" style="padding:10px 20px;font-size:14px;cursor:pointer;">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2.5 8a5.5 5.5 0 1 0 1.2-3.4M2.5 3.5v4.5h4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Reload Page
      </button>
      <a href="/" class="btn-ghost" style="padding:10px 18px;font-size:14px;">
        Return to Home
      </a>
      <a href="/contact-us" class="btn-ghost" style="padding:10px 18px;font-size:14px;">
        Report Issue
      </a>
    </div>

  </section>
</Layout>
